{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["cypress", "cypress-react-router", "node"]
    },
    "include": [
        "cypress/**/*.ts",
        "cypress/**/*.tsx",
        "cypress/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
